class ProviderRequestError(RuntimeError):
    def __init__(self, message, debug=None, status=0, retryable=False, retry_after=0):
        super().__init__(message)
        self.debug = debug or {}
        self.status = int(status or 0)
        self.retryable = bool(retryable)
        self.retry_after = float(retry_after or 0)


class ChatCancelled(RuntimeError):
    pass


def emit(payload):
    with EMIT_LOCK:
        print(json.dumps(payload, separators=(",", ":")), flush=True)


def clipped(value, limit=4000):
    text = str(value or "")
    if len(text) <= limit:
        return text
    return text[:limit] + "\n[truncated " + str(len(text) - limit) + " chars]"


def redact_debug_text(value):
    text = str(value or "")
    text = re.sub(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+", r"\1[redacted]", text)
    text = re.sub(r"(?i)(api[_-]?key[\"']?\s*[:=]\s*[\"']?)[^\"'\s,}]+", r"\1[redacted]", text)
    text = re.sub(r"(?i)(access[_-]?token[\"']?\s*[:=]\s*[\"']?)[^\"'\s,}]+", r"\1[redacted]", text)
    text = re.sub(r"(?i)(refresh[_-]?token[\"']?\s*[:=]\s*[\"']?)[^\"'\s,}]+", r"\1[redacted]", text)
    return text


def safe_url(url):
    try:
        parsed = urllib.parse.urlparse(str(url or ""))
        query = "?..." if parsed.query else ""
        return urllib.parse.urlunparse((parsed.scheme, parsed.netloc, parsed.path, "", query, ""))
    except Exception:
        return clipped(redact_debug_text(url), 600)


def safe_headers(headers):
    out = {}
    for key, value in dict(headers or {}).items():
        lower = str(key).lower()
        if lower in ("authorization", "cookie", "set-cookie", "x-api-key", "api-key"):
            out[str(key)] = "[redacted]"
        else:
            out[str(key)] = clipped(redact_debug_text(value), 400)
    return out


def payload_summary(payload):
    if not isinstance(payload, dict):
        return {"type": type(payload).__name__}
    summary = {}
    if payload.get("model") is not None:
        summary["model"] = str(payload.get("model", ""))
    if payload.get("thinkingLevel"):
        summary["thinkingLevel"] = str(payload.get("thinkingLevel", ""))
    if isinstance(payload.get("reasoning"), dict):
        reasoning = payload.get("reasoning") or {}
        summary["reasoning"] = {key: reasoning.get(key) for key in ("effort", "enabled", "exclude", "mode", "context") if reasoning.get(key) is not None}
        if reasoning.get("max_tokens") is not None:
            summary["reasoning"]["max_tokens"] = reasoning.get("max_tokens")
    if payload.get("reasoning_effort"):
        summary["reasoning_effort"] = str(payload.get("reasoning_effort", ""))
    messages = payload.get("messages")
    if isinstance(messages, list):
        summary["messages"] = len(messages)
        summary["roles"] = [str(item.get("role", "")) for item in messages if isinstance(item, dict)][-8:]
    tools = payload.get("tools")
    if isinstance(tools, list):
        summary["tools"] = len(tools)
    if payload.get("tool_choice") is not None:
        summary["toolChoice"] = str(payload.get("tool_choice", ""))
    plugins = payload.get("plugins")
    if isinstance(plugins, list):
        summary["plugins"] = [str(item.get("id", "")) for item in plugins if isinstance(item, dict)]
    return summary


def response_error_message(raw):
    text = str(raw or "")
    try:
        parsed = json.loads(text)
    except Exception:
        return clipped(redact_debug_text(text), 1200)
    if not isinstance(parsed, dict):
        return clipped(redact_debug_text(text), 1200)
    detail = parsed.get("error", parsed)
    if isinstance(detail, dict):
        for key in ("message", "detail", "error_description", "code"):
            if detail.get(key):
                return clipped(redact_debug_text(detail.get(key)), 1200)
        return clipped(redact_debug_text(json.dumps(detail, ensure_ascii=False)), 1200)
    return clipped(redact_debug_text(detail), 1200)


def retry_after_seconds(headers):
    headers = dict(headers or {})
    value = headers.get("Retry-After") or headers.get("retry-after") or ""
    try:
        return max(0.0, float(value))
    except Exception:
        return 0.0


def rate_limit_hint(headers):
    headers = dict(headers or {})
    limit = headers.get("X-RateLimit-Limit") or headers.get("x-ratelimit-limit") or ""
    remaining = headers.get("X-RateLimit-Remaining") or headers.get("x-ratelimit-remaining") or ""
    reset = headers.get("X-RateLimit-Reset") or headers.get("x-ratelimit-reset") or ""
    retry_after = headers.get("Retry-After") or headers.get("retry-after") or ""
    parts = []
    if limit:
        parts.append("limit " + str(limit))
    if remaining:
        parts.append("remaining " + str(remaining))
    if reset:
        parts.append("reset " + str(reset))
    if retry_after:
        parts.append("retry after " + str(retry_after) + "s")
    return "; ".join(parts)


def provider_debug(context, method, url, payload, request_headers, status=0, reason="", response_headers=None, body="", error_type=""):
    ctx = context or {}
    debug = {
        "provider": ctx.get("providerLabel") or ctx.get("providerId") or "Provider",
        "providerId": ctx.get("providerId") or "",
        "authMode": ctx.get("authMode") or "",
        "method": method,
        "url": safe_url(url),
        "status": int(status or 0),
        "reason": clipped(redact_debug_text(reason), 300),
        "errorType": error_type,
        "request": {
            "headers": safe_headers(request_headers),
            "payload": payload_summary(payload),
        },
        "response": {
            "headers": safe_headers(response_headers),
            "body": clipped(redact_debug_text(body), 4000),
        },
    }
    return debug


def provider_error_from_http(error, method, url, payload, request_headers, context=None):
    try:
        body = error.read().decode("utf-8", "replace")
    except Exception:
        body = ""
    status = int(getattr(error, "code", 0) or 0)
    reason = str(getattr(error, "reason", "") or getattr(error, "msg", "") or "HTTP error")
    message = response_error_message(body) or reason
    provider = (context or {}).get("providerLabel") or (context or {}).get("providerId") or "Provider"
    display = provider + " returned " + str(status) + " " + reason + (": " + message if message else "")
    headers = dict(getattr(error, "headers", {}) or {})
    hint = rate_limit_hint(headers) if status == 429 else ""
    if hint:
        display += " (" + hint + ")"
    return ProviderRequestError(
        display,
        provider_debug(context, method, url, payload, request_headers, status, reason, headers, body, "HTTPError"),
        status=status,
        retryable=status in RETRYABLE_HTTP_STATUSES,
        retry_after=retry_after_seconds(headers),
    )


def provider_error_from_exception(error, method, url, payload, request_headers, context=None):
    provider = (context or {}).get("providerLabel") or (context or {}).get("providerId") or "Provider"
    reason = compact_error(error)
    return ProviderRequestError(
        provider + " request failed: " + reason,
        provider_debug(context, method, url, payload, request_headers, 0, reason, {}, "", type(error).__name__),
        retryable=True,
    )


def check_cancel(cancel_event):
    if cancel_event is not None and cancel_event.is_set():
        raise ChatCancelled("Stopped by user.")


def sleep_with_cancel(seconds, cancel_event):
    deadline = time.monotonic() + max(0.0, float(seconds or 0))
    while time.monotonic() < deadline:
        check_cancel(cancel_event)
        time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))


def compact_error(error):
    if isinstance(error, ProviderRequestError):
        return str(error)
    if isinstance(error, ChatCancelled):
        return "Stopped by user."
    if isinstance(error, urllib.error.HTTPError):
        try:
            body = error.read().decode("utf-8", "replace")
            parsed = json.loads(body)
            if isinstance(parsed, dict):
                detail = parsed.get("error", parsed)
                if isinstance(detail, dict):
                    return str(detail.get("message", detail))
            return body or str(error)
        except Exception:
            return str(error)
    return str(error)


def error_event(operation, error):
    payload = {"type": "error", "op": operation, "message": compact_error(error)}
    if isinstance(error, ProviderRequestError):
        payload["debug"] = error.debug
        payload["retryable"] = error.retryable
        payload["status"] = error.status
        if error.retry_after:
            payload["retryAfter"] = error.retry_after
    return payload


def json_request(url, method="GET", payload=None, headers=None, timeout=REQUEST_TIMEOUT, context=None, cancel_event=None):
    check_cancel(cancel_event)
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    request_headers = {"Accept": "application/json"}
    if payload is not None:
        request_headers["Content-Type"] = "application/json"
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(url, data=data, headers=request_headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            check_cancel(cancel_event)
            raw = response.read().decode("utf-8", "replace")
            check_cancel(cancel_event)
            try:
                return json.loads(raw) if raw else {}, dict(response.headers)
            except json.JSONDecodeError as error:
                if context:
                    raise ProviderRequestError(
                        str(context.get("providerLabel") or context.get("providerId") or "Provider") + " returned invalid JSON.",
                        provider_debug(context, method, url, payload, request_headers, response.status,
                                       "Invalid JSON: " + str(error), dict(response.headers), raw, "JSONDecodeError"),
                        status=int(getattr(response, "status", 0) or 0),
                    )
                raise
    except urllib.error.HTTPError as error:
        if context:
            raise provider_error_from_http(error, method, url, payload, request_headers, context) from None
        raise
    except (TimeoutError, urllib.error.URLError, OSError) as error:
        if context:
            raise provider_error_from_exception(error, method, url, payload, request_headers, context) from None
        raise


def sse_events(response, cancel_event=None):
    event_type = ""
    data_lines = []
    check_cancel(cancel_event)
    for raw_line in response:
        check_cancel(cancel_event)
        line = raw_line.decode("utf-8", "replace").rstrip("\r\n")
        if line == "":
            if data_lines:
                yield event_type, "\n".join(data_lines)
            event_type = ""
            data_lines = []
        elif line.startswith("event:"):
            event_type = line[6:].strip()
        elif line.startswith("data:"):
            data_lines.append(line[5:].strip())
    if data_lines:
        yield event_type, "\n".join(data_lines)


def stream_json_request(url, payload, headers=None, timeout=REQUEST_TIMEOUT, on_delta=None, context=None, cancel_event=None):
    check_cancel(cancel_event)
    data = json.dumps(payload).encode("utf-8")
    request_headers = {
        "Accept": "text/event-stream",
        "Content-Type": "application/json",
    }
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(url, data=data, headers=request_headers, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            check_cancel(cancel_event)
            return parse_stream_events(sse_events(response, cancel_event), on_delta=on_delta,
                                       context=context, url=url, payload=payload,
                                       headers=request_headers, cancel_event=cancel_event), dict(response.headers)
    except urllib.error.HTTPError as error:
        if context:
            raise provider_error_from_http(error, "POST", url, payload, request_headers, context) from None
        raise
    except (TimeoutError, urllib.error.URLError, OSError) as error:
        if context:
            raise provider_error_from_exception(error, "POST", url, payload, request_headers, context) from None
        raise


def form_request(url, payload, headers=None, timeout=REQUEST_TIMEOUT):
    data = urllib.parse.urlencode(payload).encode("utf-8")
    request_headers = {
        "Accept": "application/json",
        "Content-Type": "application/x-www-form-urlencoded",
    }
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(url, data=data, headers=request_headers, method="POST")
    with urllib.request.urlopen(request, timeout=timeout) as response:
        raw = response.read().decode("utf-8", "replace")
        return json.loads(raw) if raw else {}, dict(response.headers)


def normalize_base_url(value):
    base_url = str(value or "").strip().rstrip("/")
    for suffix in ("/chat/completions", "/models"):
        if base_url.endswith(suffix):
            base_url = base_url[: -len(suffix)]
    return base_url


def now_iso():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def provider_by_id(provider_id):
    for provider in PROVIDERS:
        if provider["id"] == provider_id:
            return provider
    return PROVIDERS[-1]


def opencode_version():
    try:
        result = subprocess.run(["opencode", "--version"], capture_output=True, text=True, timeout=5)
        value = result.stdout.strip().splitlines()[0]
        return value or "unknown"
    except Exception:
        return "unknown"


def opencode_user_agent(full=False):
    version = opencode_version()
    if not full:
        return "opencode/" + version
    return "opencode/" + version + " (" + sys.platform + "; " + os.uname().machine + ")"


def read_opencode_auth():
    try:
        with open(OPENCODE_AUTH_FILE, encoding="utf-8") as source:
            data = json.load(source)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception:
        return {}


def write_opencode_auth(data):
    os.makedirs(os.path.dirname(OPENCODE_AUTH_FILE), exist_ok=True)
    tmp_path = OPENCODE_AUTH_FILE + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as target:
        json.dump(data, target, ensure_ascii=False, indent=2)
        target.write("\n")
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, OPENCODE_AUTH_FILE)


def save_opencode_oauth(provider_id, auth):
    data = read_opencode_auth()
    data[str(provider_id)] = auth
    write_opencode_auth(data)


def parse_jwt_claims(token):
    parts = str(token or "").split(".")
    if len(parts) != 3:
        return {}
    try:
        payload = parts[1] + "=" * (-len(parts[1]) % 4)
        return json.loads(base64.urlsafe_b64decode(payload.encode("ascii")).decode("utf-8"))
    except Exception:
        return {}


def extract_openai_account_id(tokens):
    for key in ("id_token", "access_token"):
        claims = parse_jwt_claims(tokens.get(key, ""))
        account_id = claims.get("chatgpt_account_id")
        if not account_id:
            auth_claims = claims.get("https://api.openai.com/auth", {})
            if isinstance(auth_claims, dict):
                account_id = auth_claims.get("chatgpt_account_id")
        if not account_id:
            organizations = claims.get("organizations", [])
            if isinstance(organizations, list) and organizations and isinstance(organizations[0], dict):
                account_id = organizations[0].get("id")
        if account_id:
            return str(account_id)
    return ""


def extract_openai_residency(access_token):
    claims = parse_jwt_claims(access_token)
    auth_claims = claims.get("https://api.openai.com/auth", {})
    residency = ""
    if isinstance(auth_claims, dict):
        residency = auth_claims.get("chatgpt_compute_residency", "")
    residency = residency or claims.get("chatgpt_compute_residency", "")
    return "" if residency == "no_constraint" else str(residency or "")


def oauth_expired(auth):
    try:
        return int(auth.get("expires", 0)) <= int(time.time() * 1000) + OAUTH_REFRESH_SKEW_MS
    except Exception:
        return True


def refresh_openai_oauth(auth):
    token, _ = form_request(OPENAI_OAUTH_ISSUER + "/oauth/token", {
        "grant_type": "refresh_token",
        "refresh_token": auth.get("refresh", ""),
        "client_id": OPENAI_OAUTH_CLIENT_ID,
    })
    refreshed = {
        "type": "oauth",
        "refresh": token.get("refresh_token", auth.get("refresh", "")),
        "access": token.get("access_token", ""),
        "expires": int(time.time() * 1000) + int(token.get("expires_in", 3600)) * 1000,
    }
    account_id = extract_openai_account_id(token) or auth.get("accountId", "")
    if account_id:
        refreshed["accountId"] = account_id
    save_opencode_oauth("openai", refreshed)
    return refreshed


def refresh_xai_oauth(auth):
    token, _ = form_request(XAI_TOKEN_URL, {
        "grant_type": "refresh_token",
        "refresh_token": auth.get("refresh", ""),
        "client_id": XAI_OAUTH_CLIENT_ID,
    }, headers={"User-Agent": opencode_user_agent()})
    refreshed = {
        "type": "oauth",
        "refresh": token.get("refresh_token", auth.get("refresh", "")),
        "access": token.get("access_token", ""),
        "expires": int(time.time() * 1000) + int(token.get("expires_in", 3600)) * 1000,
    }
    save_opencode_oauth("xai", refreshed)
    return refreshed


def get_opencode_oauth(provider_id):
    auth = read_opencode_auth().get(provider_id, {})
    if not isinstance(auth, dict) or auth.get("type") != "oauth":
        raise ValueError("Login with " + provider_id + " OAuth first.")
    if not auth.get("access") or oauth_expired(auth):
        if provider_id == "openai":
            auth = refresh_openai_oauth(auth)
        elif provider_id == "xai":
            auth = refresh_xai_oauth(auth)
    if not auth.get("access"):
        raise ValueError("OAuth access token is missing for " + provider_id + ".")
    return auth


def opencode_models(provider_id, fallback):
    try:
        result = subprocess.run(["opencode", "models", provider_id], capture_output=True, text=True, timeout=15)
        if result.returncode == 0:
            prefix = provider_id + "/"
            found = []
            for line in result.stdout.splitlines():
                line = line.strip()
                if line.startswith(prefix):
                    found.append(line[len(prefix):])
            if found:
                return found
    except Exception:
        pass
    return fallback


def secret_attributes(base_url):
    return ["service", "misza.ai-chat", "endpoint", normalize_base_url(base_url)]


def lookup_secret(base_url):
    if not base_url:
        return ""
    result = subprocess.run(
        ["secret-tool", "lookup", *secret_attributes(base_url)],
        capture_output=True,
        text=True,
        timeout=10,
    )
    return result.stdout.rstrip("\n") if result.returncode == 0 else ""


def store_secret(base_url, value):
    if not base_url:
        raise ValueError("Set an endpoint before saving its API key or OAuth token.")
    result = subprocess.run(
        [
            "secret-tool",
            "store",
            "--label=Omarchy AI Chat bearer token",
            *secret_attributes(base_url),
        ],
        input=value,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "Could not store the token in the system keyring.")


def open_url(url):
    if not url:
        raise ValueError("This provider has no configured URL.")
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pick_files():
    extensions = "png jpg jpeg webp gif bmp heic avif mp4 mov webm mkv avi m4v mp3 wav m4a flac ogg pdf txt md json csv log yaml yml"
    result = subprocess.run(
        ["omarchy", "file", "select", "--title", "Attach files", "--multiple", "--extensions", extensions],
        capture_output=True,
        text=True,
        timeout=300,
    )
    files = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if result.returncode != 0 and not files and result.stderr.strip():
        raise RuntimeError(result.stderr.strip())
    return files


def parse_local_redirect_uri(redirect_uri):
    value = str(redirect_uri or "http://127.0.0.1:53682/callback").strip()
    parsed = urllib.parse.urlparse(value)
    if parsed.scheme != "http" or parsed.hostname not in ("127.0.0.1", "localhost"):
        raise ValueError("OAuth redirect URI must be local http://127.0.0.1:<port>/callback.")
    if not parsed.port:
        raise ValueError("OAuth redirect URI must include a local port.")
    return value, parsed.hostname, parsed.port, parsed.path or "/callback"


def run_oauth_pkce(command):
    base_url = normalize_base_url(command.get("baseUrl", ""))
    authorization_url = str(command.get("authorizationUrl", "")).strip()
    token_url = str(command.get("tokenUrl", "")).strip()
    client_id = str(command.get("clientId", "")).strip()
    client_secret = str(command.get("clientSecret", "")).strip()
    scope = str(command.get("scope", "")).strip()
    audience = str(command.get("audience", "")).strip()
    redirect_uri, host, port, callback_path = parse_local_redirect_uri(command.get("redirectUri", ""))
    if not base_url:
        raise ValueError("Set the API endpoint before OAuth connect.")
    if not authorization_url or not token_url or not client_id:
        raise ValueError("OAuth needs authorization URL, token URL and client ID.")

    verifier = secrets.token_urlsafe(64)
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")
    state = secrets.token_urlsafe(24)
    result = {}

    class OAuthCallback(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            if parsed.path != callback_path:
                self.send_response(404)
                self.end_headers()
                return
            if params.get("state", [""])[0] != state:
                result["error"] = "OAuth state mismatch."
            elif params.get("error", [""])[0]:
                result["error"] = params.get("error_description", params.get("error", ["OAuth failed."]))[0]
            else:
                result["code"] = params.get("code", [""])[0]
            body = b"You can close this tab and return to Omarchy AI Chat."
            self.send_response(200 if result.get("code") else 400)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args):
            return

    server = http.server.HTTPServer((host, port), OAuthCallback)
    server.timeout = 1
    query = {
        "response_type": "code",
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    }
    if scope:
        query["scope"] = scope
    if audience:
        query["audience"] = audience
    separator = "&" if "?" in authorization_url else "?"
    browser_url = authorization_url + separator + urllib.parse.urlencode(query)
    emit({"type": "oauthStarted", "redirectUri": redirect_uri})
    open_url(browser_url)
    try:
        deadline = time.monotonic() + 180
        while time.monotonic() < deadline and not result:
            server.handle_request()
    finally:
        server.server_close()
    if result.get("error"):
        raise RuntimeError(result["error"])
    code = result.get("code")
    if not code:
        raise TimeoutError("OAuth timed out waiting for browser callback.")

    token_payload = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "client_id": client_id,
        "code_verifier": verifier,
    }
    if client_secret:
        token_payload["client_secret"] = client_secret
    token, _ = form_request(token_url, token_payload)
    access_token = str(token.get("access_token", ""))
    if not access_token:
        raise RuntimeError("OAuth token endpoint did not return an access_token.")
    store_secret(base_url, access_token)
    refresh_token = str(token.get("refresh_token", ""))
    if refresh_token:
        store_secret(base_url + "#refresh", refresh_token)
    return {"expiresIn": token.get("expires_in", 0), "tokenType": token.get("token_type", "Bearer")}


def wait_for_oauth_code(callback_path, state, open_browser, timeout=600, host="127.0.0.1", port=0, callback_host="127.0.0.1"):
    result = {}

    class OAuthCallback(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            if parsed.path != callback_path:
                self.send_response(404)
                self.end_headers()
                return
            if state and params.get("state", [""])[0] != state:
                result["error"] = "OAuth state mismatch."
            elif params.get("error", [""])[0]:
                result["error"] = params.get("error_description", params.get("error", ["OAuth failed."]))[0]
            else:
                result["code"] = params.get("code", [""])[0]
            body = b"OAuth finished. You can close this tab and return to Omarchy AI Chat."
            self.send_response(200 if result.get("code") else 400)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args):
            return

    server = http.server.HTTPServer((host, port), OAuthCallback)
    server.timeout = 1
    callback_url = "http://" + callback_host + ":" + str(server.server_address[1]) + callback_path
    emit({"type": "oauthStarted", "redirectUri": callback_url,
          "message": "Opened provider login. Waiting for callback on " + callback_url + "."})
    open_browser(callback_url)
    try:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and not result:
            server.handle_request()
    finally:
        server.server_close()
    if result.get("error"):
        raise RuntimeError(result["error"])
    if not result.get("code"):
        raise TimeoutError("OAuth timed out waiting for browser callback.")
    return result["code"]


def run_openrouter_oauth(base_url):
    endpoint = normalize_base_url(base_url) or "https://openrouter.ai/api/v1"
    verifier = secrets.token_urlsafe(64)
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")
    callback_path = "/callback"

    def open_browser(callback_url):
        query = urllib.parse.urlencode({
            "callback_url": callback_url,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "key_label": "misza.ai-chat",
        })
        open_url("https://openrouter.ai/auth?" + query)

    code = wait_for_oauth_code(callback_path, "", open_browser)
    token, _ = json_request("https://openrouter.ai/api/v1/auth/keys", "POST", {
        "code": code,
        "code_verifier": verifier,
        "code_challenge_method": "S256",
    })
    key = str(token.get("key", ""))
    if not key:
        raise RuntimeError("OpenRouter did not return an API key.")
    store_secret(endpoint, key)
    return {"tokenType": "OpenRouter API key", "userId": token.get("user_id", "")}


def run_openai_opencode_oauth():
    verifier = "".join(secrets.choice("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~") for _ in range(43))
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")
    state = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode("ascii").rstrip("=")
    callback_path = "/auth/callback"

    def open_browser(callback_url):
        query = urllib.parse.urlencode({
            "response_type": "code",
            "client_id": OPENAI_OAUTH_CLIENT_ID,
            "redirect_uri": callback_url,
            "scope": "openid profile email offline_access",
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "id_token_add_organizations": "true",
            "codex_cli_simplified_flow": "true",
            "state": state,
            "originator": "opencode",
        })
        open_url(OPENAI_OAUTH_ISSUER + "/oauth/authorize?" + query)

    code = wait_for_oauth_code(callback_path, state, open_browser, timeout=300,
                               host="127.0.0.1", port=OPENAI_OAUTH_PORT, callback_host="localhost")
    redirect_uri = "http://localhost:" + str(OPENAI_OAUTH_PORT) + callback_path
    token, _ = form_request(OPENAI_OAUTH_ISSUER + "/oauth/token", {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "client_id": OPENAI_OAUTH_CLIENT_ID,
        "code_verifier": verifier,
    })
    auth = {
        "type": "oauth",
        "refresh": token.get("refresh_token", ""),
        "access": token.get("access_token", ""),
        "expires": int(time.time() * 1000) + int(token.get("expires_in", 3600)) * 1000,
    }
    account_id = extract_openai_account_id(token)
    if account_id:
        auth["accountId"] = account_id
    if not auth["refresh"] or not auth["access"]:
        raise RuntimeError("OpenAI OAuth did not return access and refresh tokens.")
    save_opencode_oauth("openai", auth)
    return {"tokenType": "OpenAI ChatGPT OAuth", "provider": "openai"}


def run_xai_device_oauth():
    device, _ = form_request(XAI_DEVICE_URL, {
        "client_id": XAI_OAUTH_CLIENT_ID,
        "scope": XAI_SCOPE,
        "referrer": "opencode",
    }, headers={"User-Agent": opencode_user_agent()})
    device_code = str(device.get("device_code", ""))
    user_code = str(device.get("user_code", ""))
    verification_uri = str(device.get("verification_uri", ""))
    browser_url = str(device.get("verification_uri_complete", "")) or verification_uri
    if not device_code or not user_code or not verification_uri:
        raise RuntimeError("xAI OAuth response is missing device_code, user_code or verification_uri.")
    emit({"type": "oauthStarted", "message": "Opened xAI login. Enter code " + user_code + " if the browser asks for it."})
    open_url(browser_url)
    interval = max(int(device.get("interval", 5) or 5), 1)
    deadline = time.monotonic() + int(device.get("expires_in", 300) or 300)
    while time.monotonic() < deadline:
        time.sleep(interval + 3)
        try:
            token, _ = form_request(XAI_TOKEN_URL, {
                "grant_type": XAI_DEVICE_GRANT,
                "client_id": XAI_OAUTH_CLIENT_ID,
                "device_code": device_code,
            }, headers={"User-Agent": opencode_user_agent()})
        except urllib.error.HTTPError as error:
            try:
                body = json.loads(error.read().decode("utf-8", "replace") or "{}")
            except Exception:
                body = {}
            code = body.get("error", "") if isinstance(body, dict) else ""
            if code == "authorization_pending":
                continue
            if code == "slow_down":
                interval += 5
                continue
            if code in ("access_denied", "authorization_denied"):
                raise RuntimeError("xAI OAuth authorization was denied.")
            if code == "expired_token":
                raise RuntimeError("xAI OAuth code expired.")
            raise RuntimeError(compact_error(error))
        auth = {
            "type": "oauth",
            "refresh": token.get("refresh_token", ""),
            "access": token.get("access_token", ""),
            "expires": int(time.time() * 1000) + int(token.get("expires_in", 3600)) * 1000,
        }
        if not auth["refresh"] or not auth["access"]:
            raise RuntimeError("xAI OAuth did not return access and refresh tokens.")
        save_opencode_oauth("xai", auth)
        return {"tokenType": "xAI OAuth", "provider": "xai"}
    raise TimeoutError("xAI OAuth timed out waiting for authorization.")


def read_json_file(path):
    with open(path, encoding="utf-8") as source:
        return json.load(source)


def mcp_key(path, name):
    return os.path.abspath(os.path.expanduser(path)) + "::" + str(name)


def split_mcp_key(key):
    if "::" not in key:
        return "", ""
    return key.rsplit("::", 1)


def normalize_mcp_config(config):
    if not isinstance(config, dict):
        return config
    normalized = dict(config)
    command = normalized.get("command")
    if isinstance(command, dict):
        normalized["command"] = command.get("path") or command.get("command") or command.get("name") or ""
        if "args" not in normalized and isinstance(command.get("args"), list):
            normalized["args"] = command.get("args")
    if "url" not in normalized and isinstance(normalized.get("serverUrl"), str):
        normalized["url"] = normalized.get("serverUrl")
    return normalized


def extract_mcp_servers(document):
    candidates = []
    if isinstance(document, dict):
        for key in ("mcpServers", "mcp_servers", "context_servers", "contextServers"):
            if isinstance(document.get(key), dict):
                candidates.append(document[key])
        mcp = document.get("mcp")
        if isinstance(mcp, dict):
            if isinstance(mcp.get("servers"), dict):
                candidates.append(mcp["servers"])
            elif any(isinstance(value, dict) for value in mcp.values()):
                candidates.append(mcp)
    servers = {}
    for group in candidates:
        for name, config in group.items():
            if isinstance(config, dict):
                servers[str(name)] = normalize_mcp_config(config)
    return servers


def discover_mcp_configs(extra_path=""):
    paths = []
    seen = set()

    def add(label, path):
        expanded = os.path.abspath(os.path.expanduser(path))
        if expanded in seen:
            return
        seen.add(expanded)
        paths.append((label, expanded))

    for label, path in MCP_CONFIG_CANDIDATES:
        add(label, path)
    if extra_path:
        add("Custom", extra_path)

    configs = []
    flat_servers = []
    for label, path in paths:
        if not os.path.exists(path):
            continue
        try:
            document = read_json_file(path)
            servers = extract_mcp_servers(document)
        except Exception as error:
            configs.append({"label": label, "path": path, "error": compact_error(error), "servers": []})
            continue
        if not servers:
            continue
        server_rows = []
        for name, config in sorted(servers.items()):
            key = mcp_key(path, name)
            disabled = bool(config.get("disabled") or config.get("enabled") is False)
            transport = "http" if config.get("url") else "stdio"
            command = str(config.get("url") or config.get("command") or "")
            row = {
                "key": key,
                "name": name,
                "label": name + " / " + label,
                "source": label,
                "path": path,
                "transport": transport,
                "command": command,
                "disabled": disabled,
            }
            server_rows.append(row)
            flat_servers.append(row)
        configs.append({"label": label, "path": path, "servers": server_rows})
    return configs, flat_servers


def read_chats():
    try:
        document = read_json_file(CHATS_FILE)
        chats = document.get("chats", []) if isinstance(document, dict) else []
        return chats if isinstance(chats, list) else []
    except FileNotFoundError:
        return []
    except Exception:
        return []


def write_chats(chats):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp_path = CHATS_FILE + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as target:
        json.dump({"chats": chats}, target, ensure_ascii=False, indent=2)
        target.write("\n")
    os.replace(tmp_path, CHATS_FILE)


def chat_title(prompt):
    title = " ".join(str(prompt or "").strip().split())
    if not title:
        return "New chat"
    return title[:57] + "..." if len(title) > 60 else title


def parse_iso_datetime(value):
    try:
        parsed = dt.datetime.fromisoformat(str(value or "").replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed.astimezone()
    except Exception:
        return None


def chat_group_label(value):
    parsed = parse_iso_datetime(value)
    if not parsed:
        return "Older"
    today = dt.datetime.now().astimezone().date()
    date = parsed.date()
    if date == today:
        return "Today"
    if date == today - dt.timedelta(days=1):
        return "Yesterday"
    return date.isoformat()


def attachment_kind(source, mime):
    lower = str(source or "").lower()
    if str(mime or "").startswith("image/"):
        return "image"
    if str(mime or "").startswith("video/"):
        return "video"
    if str(mime or "").startswith("audio/"):
        return "audio"
    if lower.endswith(".pdf"):
        return "pdf"
    return "file"


def guess_mime(source):
    mime, _ = mimetypes.guess_type(str(source or ""))
    return mime or "application/octet-stream"


def attachment_summary(source, mime=""):
    label = str(source or "").strip()
    if label.startswith("http://") or label.startswith("https://"):
        display = label
    else:
        display = os.path.basename(os.path.expanduser(label)) or label
    guessed = mime or guess_mime(label)
    return {"label": display, "source": label, "mime": guessed, "kind": attachment_kind(label, guessed)}


def data_url_for_file(path, mime):
    size = os.path.getsize(path)
    if size > MAX_ATTACHMENT_BYTES:
        raise ValueError("Attachment is larger than 64 MB: " + os.path.basename(path))
    with open(path, "rb") as source:
        encoded = base64.b64encode(source.read()).decode("ascii")
    return "data:" + mime + ";base64," + encoded


def text_from_file(path):
    with open(path, "rb") as source:
        raw = source.read(MAX_TEXT_ATTACHMENT_CHARS + 4096)
    text = raw.decode("utf-8", "replace")
    if len(text) > MAX_TEXT_ATTACHMENT_CHARS:
        text = text[:MAX_TEXT_ATTACHMENT_CHARS] + "\n[truncated]"
    return text


def source_filename(source):
    text = str(source or "")
    if text.startswith("http://") or text.startswith("https://"):
        path = urllib.parse.urlparse(text).path
        name = os.path.basename(urllib.parse.unquote(path))
        return name or "attachment"
    return os.path.basename(os.path.abspath(os.path.expanduser(text))) or "attachment"


def openrouter_file_part(source, file_data):
    return {"type": "file", "file": {"filename": source_filename(source), "file_data": file_data}}


def content_from_prompt(prompt, attachments, provider_id=""):
    items = [{"type": "text", "text": prompt}]
    for attachment in attachments:
        source = str(attachment.get("source", attachment.get("path", ""))).strip()
        if not source:
            continue
        mime = str(attachment.get("mime", "") or guess_mime(source))
        kind = attachment_kind(source, mime)
        is_pdf = mime == "application/pdf" or source.lower().split("?", 1)[0].endswith(".pdf")
        if source.startswith("http://") or source.startswith("https://"):
            url = source
        else:
            path = os.path.abspath(os.path.expanduser(source))
            if not os.path.exists(path):
                raise FileNotFoundError(source)
            if mime.startswith("text/") or os.path.splitext(path)[1].lower() in (".md", ".json", ".csv", ".log", ".txt", ".yaml", ".yml"):
                items.append({"type": "text", "text": "Attached file " + os.path.basename(path) + ":\n" + text_from_file(path)})
                continue
            url = data_url_for_file(path, mime)
        if provider_id == "openrouter" and is_pdf:
            items.append(openrouter_file_part(source, url))
            continue
        if kind == "image":
            items.append({"type": "image_url", "image_url": {"url": url}})
        elif kind == "video":
            items.append({"type": "video_url", "video_url": {"url": url}})
        elif kind == "audio" and not url.startswith("http"):
            data = url.split(",", 1)[1] if "," in url else url
            items.append({"type": "input_audio", "input_audio": {"data": data, "format": mime.rsplit("/", 1)[-1]}})
        else:
            items.append({"type": "text", "text": "Attached file: " + source + " (" + mime + ")"})
    return items if len(items) > 1 else prompt


def message_from_completion_response(response):
    if not isinstance(response, dict):
        return {}
    if response.get("role") and ("content" in response or "tool_calls" in response):
        return response
    if isinstance(response.get("message"), dict):
        return response["message"]
    choices = response.get("choices", [])
    if choices:
        choice = choices[0]
        if isinstance(choice, dict):
            message = choice.get("message")
            if isinstance(message, dict):
                return message
            if choice.get("text") is not None:
                return {"role": "assistant", "content": str(choice.get("text", ""))}
            delta = choice.get("delta")
            if isinstance(delta, dict):
                return {"role": "assistant", "content": str(delta.get("content", ""))}
        return {}
    output = response.get("output", [])
    if isinstance(output, list):
        texts = []
        calls = []
        for item in output:
            if not isinstance(item, dict):
                continue
            if item.get("type") == "message":
                for part in item.get("content", []) or []:
                    if isinstance(part, dict):
                        text = part.get("text") or part.get("output_text")
                        if text:
                            texts.append(str(text))
            if item.get("type") in ("function_call", "tool_call"):
                calls.append({
                    "id": item.get("call_id") or item.get("id") or "",
                    "type": "function",
                    "function": {
                        "name": item.get("name", ""),
                        "arguments": item.get("arguments", "{}"),
                    },
                })
        message = {"role": "assistant", "content": "\n".join(texts)}
        if calls:
            message["tool_calls"] = calls
        if texts or calls:
            return message
    if response.get("output_text"):
        return {"role": "assistant", "content": str(response.get("output_text"))}
    return {}


def append_chat_tool_delta(calls, delta):
    for item in delta.get("tool_calls", []) or []:
        if not isinstance(item, dict):
            continue
        index = str(item.get("index", len(calls)))
        call = calls.setdefault(index, {"id": "", "type": "function", "function": {"name": "", "arguments": ""}})
        if item.get("id"):
            call["id"] = item["id"]
        function = item.get("function", {})
        if isinstance(function, dict):
            if function.get("name"):
                call["function"]["name"] += str(function.get("name", ""))
            if function.get("arguments"):
                call["function"]["arguments"] += str(function.get("arguments", ""))


def response_item_message(item):
    if not isinstance(item, dict):
        return {}
    if item.get("type") in ("function_call", "tool_call"):
        return {
            "role": "assistant",
            "content": "",
            "tool_calls": [{
                "id": item.get("call_id") or item.get("id") or "",
                "type": "function",
                "function": {
                    "name": item.get("name", ""),
                    "arguments": item.get("arguments", "{}"),
                },
            }],
        }
    if item.get("type") == "message":
        texts = []
        for part in item.get("content", []) or []:
            if isinstance(part, dict):
                text = part.get("text") or part.get("output_text")
                if text:
                    texts.append(str(text))
        if texts:
            return {"role": "assistant", "content": "\n".join(texts)}
    return {}


def first_present(*values):
    for value in values:
        if value is not None and value != "":
            return value
    return ""


def parse_stream_events(events, on_delta=None, context=None, url="", payload=None, headers=None, cancel_event=None):
    texts = []
    response_items = []
    chat_calls = {}
    completed_response = None
    response_call_arguments = {}
    response_call_names = {}
    response_call_ids = {}

    def push_delta(text):
        if not text:
            return
        text = str(text)
        texts.append(text)
        if on_delta:
            on_delta(text)

    for event_type, data in events:
        check_cancel(cancel_event)
        if data == "[DONE]":
            break
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        kind = str(event.get("type") or event_type or "")
        event_error = event.get("error")
        if isinstance(event_error, dict) and any(isinstance(choice, dict) and choice.get("finish_reason") == "error"
                                                for choice in event.get("choices", []) or []):
            code = int(event_error.get("code", 0) or 0)
            message = str(event_error.get("message", event_error))
            if context:
                provider = str(context.get("providerLabel") or context.get("providerId") or "Provider")
                raise ProviderRequestError(
                    provider + " stream error" + (" " + str(code) if code else "") + ": " + clipped(redact_debug_text(message), 1200),
                    provider_debug(context, "POST", url, payload, headers, code, message, {},
                                   json.dumps(event, ensure_ascii=False), "StreamError"),
                    status=code,
                    retryable=code in RETRYABLE_HTTP_STATUSES,
                )
            raise RuntimeError(message)
        if kind == "error" or kind.endswith(".failed"):
            detail = event.get("error", event)
            if isinstance(detail, dict):
                message = str(detail.get("message", detail))
            else:
                message = str(detail)
            if context:
                provider = str(context.get("providerLabel") or context.get("providerId") or "Provider")
                raise ProviderRequestError(
                    provider + " stream error: " + clipped(redact_debug_text(message), 1200),
                    provider_debug(context, "POST", url, payload, headers, 0, message, {},
                                   json.dumps(event, ensure_ascii=False), "StreamError"),
                    retryable=True,
                )
            raise RuntimeError(message)
        if "choices" in event:
            for choice in event.get("choices", []) or []:
                delta = choice.get("delta", {}) if isinstance(choice, dict) else {}
                if isinstance(delta, dict):
                    push_delta(delta.get("content") or "")
                    append_chat_tool_delta(chat_calls, delta)
            continue
        if kind in ("response.output_text.delta", "response.text.delta"):
            push_delta(event.get("delta") or event.get("text") or "")
            continue
        if kind in ("response.output_text.done", "response.text.done"):
            if not texts:
                push_delta(event.get("text") or event.get("output_text") or "")
            continue
        if kind in ("response.function_call_arguments.delta", "response.tool_call_arguments.delta"):
            key = str(first_present(event.get("item_id"), event.get("output_index"), event.get("call_id"), len(response_call_arguments)))
            response_call_arguments[key] = response_call_arguments.get(key, "") + str(event.get("delta", ""))
            if event.get("call_id"):
                response_call_ids[key] = str(event.get("call_id", ""))
            continue
        if kind in ("response.output_item.done", "response.output_item.added"):
            item = event.get("item") or event.get("output_item")
            if isinstance(item, dict):
                response_items.append(item)
                key = str(first_present(event.get("item_id"), event.get("output_index"), item.get("id"), item.get("call_id"), len(response_items) - 1))
                if item.get("name"):
                    response_call_names[key] = str(item.get("name", ""))
                if item.get("call_id") or item.get("id"):
                    response_call_ids[key] = str(item.get("call_id") or item.get("id") or "")
            continue
        if kind in ("response.completed", "response.done"):
            completed_response = event.get("response") if isinstance(event.get("response"), dict) else event
            continue

    if completed_response:
        message = message_from_completion_response(completed_response)
        if message:
            return message
    calls = []
    for item in response_items:
        message = response_item_message(item)
        calls.extend(message.get("tool_calls", []))
    for key, arguments in response_call_arguments.items():
        name = response_call_names.get(key, "")
        if not name:
            continue
        calls.append({
            "id": response_call_ids.get(key, key),
            "type": "function",
            "function": {"name": name, "arguments": arguments or "{}"},
        })
    calls.extend(call for _, call in sorted(chat_calls.items()))
    message = {"role": "assistant", "content": "".join(texts)}
    if calls:
        message["tool_calls"] = calls
    return message if texts or calls else {}


def response_content_items(content, assistant=False):
    text_type = "output_text" if assistant else "input_text"
    if isinstance(content, str):
        return [{"type": text_type, "text": content}] if content else []
    if not isinstance(content, list):
        return []
    items = []
    for part in content:
        if not isinstance(part, dict):
            continue
        if part.get("type") == "text":
            items.append({"type": text_type, "text": str(part.get("text", ""))})
        elif part.get("type") == "image_url":
            image = part.get("image_url", {})
            url = image.get("url", "") if isinstance(image, dict) else str(image or "")
            if url:
                items.append({"type": "input_image", "image_url": url})
        elif part.get("type") == "video_url":
            video = part.get("video_url", {})
            url = video.get("url", "") if isinstance(video, dict) else str(video or "")
            if url:
                items.append({"type": "input_video", "video_url": url})
        elif part.get("type") == "input_audio":
            audio = part.get("input_audio", {})
            if isinstance(audio, dict):
                items.append({"type": "input_audio", "input_audio": audio})
    return [item for item in items if item.get("text", "x") != ""]


def responses_input_from_messages(messages):
    items = []
    for message in messages:
        if not isinstance(message, dict):
            continue
        role = str(message.get("role", ""))
        if role in ("system", "user", "assistant"):
            content = response_content_items(message.get("content", ""), assistant=role == "assistant")
            if content:
                items.append({"type": "message", "role": role, "content": content})
            for call in message.get("tool_calls", []) or []:
                if not isinstance(call, dict):
                    continue
                function = call.get("function", {})
                if not isinstance(function, dict):
                    continue
                items.append({
                    "type": "function_call",
                    "call_id": call.get("id", ""),
                    "name": function.get("name", ""),
                    "arguments": function.get("arguments", "{}"),
                })
        elif role == "tool":
            items.append({
                "type": "function_call_output",
                "call_id": message.get("tool_call_id", ""),
                "output": str(message.get("content", "")),
            })
    return items


def responses_tools(openai_tools):
    tools = []
    for tool in openai_tools:
        function = tool.get("function", {}) if isinstance(tool, dict) else {}
        if not isinstance(function, dict):
            continue
        tools.append({
            "type": "function",
            "name": function.get("name", ""),
            "description": function.get("description", ""),
            "parameters": function.get("parameters", {"type": "object", "properties": {}}),
        })
    return tools


def response_payload_from_chat_payload(payload, tools, stream=False):
    result = {
        "model": payload.get("model", ""),
        "input": responses_input_from_messages(payload.get("messages", [])),
        "store": False,
    }
    if stream:
        result["stream"] = True
    effort = str(payload.get("thinkingLevel", "") or "").strip()
    if effort and effort not in ("default", "auto", "off"):
        result["reasoning"] = {"effort": effort}
    converted_tools = responses_tools(tools)
    if converted_tools:
        result["tools"] = converted_tools
        result["tool_choice"] = "auto"
    return result


def message_has_openrouter_file(messages):
    for message in messages if isinstance(messages, list) else []:
        if not isinstance(message, dict):
            continue
        content = message.get("content")
        if not isinstance(content, list):
            continue
        for part in content:
            if isinstance(part, dict) and part.get("type") == "file":
                return True
    return False


def chat_completion_payload_for_provider(provider_id, payload):
    result = dict(payload or {})
    effort = str(result.pop("thinkingLevel", "") or "").strip()
    if effort and effort not in ("default", "auto", "off"):
        if provider_id == "openrouter":
            result["reasoning"] = {"effort": effort}
        elif provider_id in ("openai", "xai"):
            result["reasoning_effort"] = effort
    if provider_id == "openrouter" and message_has_openrouter_file(result.get("messages", [])):
        plugins = [plugin for plugin in result.get("plugins", []) if isinstance(plugin, dict)] if isinstance(result.get("plugins"), list) else []
        if not any(plugin.get("id") == "file-parser" for plugin in plugins):
            plugins.append({"id": "file-parser", "pdf": {"engine": "cloudflare-ai"}})
        result["plugins"] = plugins
    return result


def thinking_level_rows(values, default_value="", mandatory=False):
    seen = set()
    rows = []
    for value in values:
        value = str(value or "").strip()
        if not value or value in seen or value == "default" or (mandatory and value == "none"):
            continue
        seen.add(value)
        rows.append({"value": value, "label": value})
    if not rows:
        return []
    label = "Default" + (" (" + default_value + ")" if default_value else "")
    return [{"value": "default", "label": label}] + rows


def thinking_levels_from_reasoning(reasoning):
    if not isinstance(reasoning, dict):
        return []
    default_effort = str(reasoning.get("default_effort", "") or "").strip()
    mandatory = bool(reasoning.get("mandatory"))
    if "supported_efforts" in reasoning:
        supported = reasoning.get("supported_efforts")
        if supported is None:
            return thinking_level_rows(OPENROUTER_REASONING_EFFORTS, default_effort, mandatory)
        if isinstance(supported, list):
            return thinking_level_rows(supported, default_effort, mandatory)
    if default_effort:
        return thinking_level_rows([default_effort], default_effort, mandatory)
    return []


def gpt5_version(model_id):
    match = re.search(r"(?:^|/)gpt-5[.-](\d+)(?:[.-]|$)", model_id)
    return int(match.group(1)) if match else None


def thinking_levels(provider_id, model_id, metadata=None):
    lower = str(model_id or "").lower()
    if provider_id == "openrouter" and isinstance(metadata, dict):
        rows = thinking_levels_from_reasoning(metadata.get("reasoning"))
        if rows:
            return rows
    if provider_id == "openai" and re.search(r"(?:^|/)gpt-5(?:[.-]|$)", lower):
        version = gpt5_version(lower)
        if "-chat" in lower:
            return thinking_level_rows(["medium"])
        if "codex" in lower:
            values = ["low", "medium", "high"]
            if version is not None and version >= 3:
                values = ["none"] + values + ["xhigh"]
            elif "codex-max" in lower or (version is not None and version >= 2):
                values = values + ["xhigh"]
            return thinking_level_rows(values)
        if version is not None and version >= 2:
            return thinking_level_rows(["none", "low", "medium", "high", "xhigh"])
        if version == 1:
            return thinking_level_rows(["none", "low", "medium", "high"])
        return thinking_level_rows(["minimal", "low", "medium", "high"])
    if provider_id == "openrouter" and (lower.startswith("openai/gpt-5") or "/gpt-5" in lower):
        return thinking_level_rows(["none", "low", "medium", "high", "xhigh"])
    if provider_id == "xai" and "grok-3-mini" in lower:
        return thinking_level_rows(["low", "high"])
    return []


def model_capabilities(provider_id, model_id, metadata=None):
    lower = str(model_id or "").lower()
    if provider_id == "openrouter" and isinstance(metadata, dict):
        architecture = metadata.get("architecture", {}) if isinstance(metadata.get("architecture", {}), dict) else {}
        input_modalities = {str(item).lower() for item in architecture.get("input_modalities", []) if item}
        output_modalities = {str(item).lower() for item in architecture.get("output_modalities", []) if item}
        supported_parameters = {str(item) for item in metadata.get("supported_parameters", []) if item}
        return {
            "toolCalls": "tools" in supported_parameters,
            "toolChoice": "tool_choice" in supported_parameters,
            "image": "image" in input_modalities,
            "video": "video" in input_modalities,
            "audio": "audio" in input_modalities,
            "files": True,
            "outputImage": "image" in output_modalities,
            "outputAudio": "audio" in output_modalities or "speech" in output_modalities,
            "outputVideo": "video" in output_modalities,
            "contextLength": metadata.get("context_length", 0) or 0,
            "supportedParameters": sorted(supported_parameters),
            "thinkingLevels": thinking_levels(provider_id, lower, metadata),
        }
    image = provider_id in ("openai", "xai", "openrouter") or any(token in lower for token in ("vision", "vl", "image", "gpt-4o"))
    video = provider_id == "xai" and "video" in lower
    return {
        "toolCalls": True,
        "toolChoice": True,
        "image": image,
        "video": video,
        "audio": provider_id in ("openai", "openrouter") and any(token in lower for token in ("audio", "gpt-4o")),
        "files": True,
        "thinkingLevels": thinking_levels(provider_id, lower),
    }


def model_row(provider_id, model_id, metadata=None):
    row = {"id": model_id, "label": model_id, "capabilities": model_capabilities(provider_id, model_id, metadata)}
    if isinstance(metadata, dict):
        name = str(metadata.get("name", "") or "")
        description = []
        if name and name != model_id:
            description.append(name)
        context_length = metadata.get("context_length", 0) or 0
        if context_length:
            description.append(str(context_length) + " ctx")
        reasoning = metadata.get("reasoning")
        if isinstance(reasoning, dict):
            if reasoning.get("mandatory"):
                description.append("reasoning required")
            elif reasoning.get("default_enabled"):
                description.append("reasoning default")
        if description:
            row["description"] = " / ".join(description)
    return row


def provider_auth_status(provider, opencode_auth):
    provider_id = provider.get("id", "")
    base_url = normalize_base_url(provider.get("baseUrl", ""))
    oauth = provider.get("oauth", {}) if isinstance(provider.get("oauth", {}), dict) else {}
    auth = opencode_auth.get(provider_id, {}) if isinstance(opencode_auth, dict) else {}
    if oauth.get("kind", "").startswith("opencode-"):
        return "signed in with OpenCode" if isinstance(auth, dict) and auth.get("type") == "oauth" else "not signed in"
    if oauth.get("kind") == "openrouter" and base_url and lookup_secret(base_url):
        return "API key saved"
    if provider.get("defaultAuthMode") == "none":
        return "no auth"
    if base_url and lookup_secret(base_url):
        return "API key saved"
    return "not signed in"


class McpClient:
    def __init__(self, name, config):
        self.name = name
        self.config = config
        self.process = None
        self.url = ""
        self.session_id = ""
        self.next_id = 1
        self.tools = []

    def connect(self):
        if self.config.get("disabled") or self.config.get("enabled") is False:
            return "disabled"
        if self.config.get("url"):
            self.url = str(self.config["url"])
        else:
            command = self.config.get("command", [])
            if isinstance(command, str):
                command = [command] + list(self.config.get("args", []))
            if not isinstance(command, list) or not command:
                raise ValueError("needs a URL or command")
            environment = os.environ.copy()
            environment.update({str(k): str(v) for k, v in self.config.get("env", self.config.get("environment", {})).items()})
            cwd = self.config.get("cwd") or None
            self.process = subprocess.Popen(
                command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
                env=environment,
                cwd=os.path.expanduser(str(cwd)) if cwd else None,
            )
        self.request("initialize", {
            "protocolVersion": MCP_PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": CLIENT_INFO,
        })
        self.notify("notifications/initialized", {})
        result = self.request("tools/list", {})
        self.tools = result.get("tools", []) if isinstance(result, dict) else []
        return "connected"

    def close(self):
        if self.process and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.process.kill()

    def notify(self, method, params):
        request = {"jsonrpc": "2.0", "method": method, "params": params}
        if self.url:
            self._http_request(request)
            return
        self._stdio_write(request)

    def request(self, method, params):
        request_id = self.next_id
        self.next_id += 1
        request = {"jsonrpc": "2.0", "id": request_id, "method": method, "params": params}
        if self.url:
            response = self._http_request(request)
        else:
            self._stdio_write(request)
            response = self._stdio_response(request_id)
        if not isinstance(response, dict):
            raise RuntimeError("MCP returned an invalid response")
        if "error" in response:
            error = response["error"]
            raise RuntimeError(str(error.get("message", error)) if isinstance(error, dict) else str(error))
        return response.get("result", {})

    def _stdio_write(self, request):
        if not self.process or not self.process.stdin:
            raise RuntimeError("MCP process is not running")
        self.process.stdin.write(json.dumps(request) + "\n")
        self.process.stdin.flush()

    def _stdio_response(self, request_id):
        if not self.process or not self.process.stdout:
            raise RuntimeError("MCP process is not running")
        deadline = time.monotonic() + REQUEST_TIMEOUT
        while time.monotonic() < deadline:
            remaining = max(0, deadline - time.monotonic())
            readable, _, _ = select.select([self.process.stdout], [], [], remaining)
            if not readable:
                break
            line = self.process.stdout.readline()
            if not line:
                raise RuntimeError("MCP process closed its output")
            try:
                response = json.loads(line)
            except json.JSONDecodeError:
                continue
            if response.get("id") == request_id:
                return response
        raise TimeoutError("MCP request timed out")

    def _http_request(self, request):
        headers = {
            "Accept": "application/json, text/event-stream",
            "Content-Type": "application/json",
        }
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
        data = json.dumps(request).encode("utf-8")
        http_request = urllib.request.Request(self.url, data=data, headers=headers, method="POST")
        with urllib.request.urlopen(http_request, timeout=REQUEST_TIMEOUT) as response:
            self.session_id = response.headers.get("Mcp-Session-Id", self.session_id)
            raw = response.read().decode("utf-8", "replace")
        if not raw:
            return {}
        if raw.lstrip().startswith("{"):
            return json.loads(raw)
        for line in raw.splitlines():
            if line.startswith("data:"):
                return json.loads(line[5:].strip())
        raise RuntimeError("MCP HTTP server returned no JSON-RPC response")


class Bridge:
    def __init__(self):
        self.provider_id = "custom"
        self.auth_mode = "key"
        self.base_url = ""
        self.model = ""
        self.thinking_level = ""
        self.mcp_path = ""
        self.mcp_enabled = []
        self.messages = []
        self.ui_messages = []
        self.current_chat_id = ""
        self.current_title = ""
        self.mcp_clients = {}
        self.tool_map = {}
        self.model_capabilities = {}
        self.chat_thread = None
        self.chat_cancel = None
        self.chat_token = ""
        self.chat_state_lock = threading.Lock()

    def discover(self):
        profiles = []
        seen = set()

        def add_profile(label, base_url, model="", mcp_path="", provider_id="custom", auth_mode=""):
            base_url = normalize_base_url(base_url)
            if not base_url or base_url in seen:
                return
            seen.add(base_url)
            profiles.append({"label": label, "baseUrl": base_url, "model": model, "mcpPath": mcp_path,
                             "providerId": provider_id, "authMode": auth_mode})

        opencode_auth = read_opencode_auth()
        if isinstance(opencode_auth.get("openai"), dict) and opencode_auth["openai"].get("type") == "oauth":
            add_profile("OpenAI ChatGPT plan (OpenCode)", "https://api.openai.com/v1", "gpt-5.5", provider_id="openai", auth_mode="oauth")
        if isinstance(opencode_auth.get("xai"), dict) and opencode_auth["xai"].get("type") == "oauth":
            add_profile("xAI SuperGrok plan (OpenCode)", "https://api.x.ai/v1", "grok-build-0.1", provider_id="xai", auth_mode="oauth")

        opencode_path = os.path.expanduser("~/.config/opencode/opencode.json")
        try:
            config = read_json_file(opencode_path)
            for provider_id, provider in config.get("provider", {}).items():
                options = provider.get("options", {})
                base_url = options.get("baseURL", "")
                if not base_url:
                    continue
                model_ids = list(provider.get("models", {}).keys())
                add_profile(provider.get("name", provider_id), base_url,
                            model_ids[0] if model_ids else "", opencode_path, provider_id)
        except (OSError, ValueError, AttributeError):
            pass

        for provider in PROVIDERS:
            if provider["id"] in ("custom", "openai", "xai", "kimi", "zai", "openrouter"):
                continue
            try:
                models, _ = json_request(normalize_base_url(provider["baseUrl"]) + "/models", timeout=1.5)
                if models.get("data"):
                    add_profile(provider["label"], provider["baseUrl"], provider_id=provider["id"])
            except (OSError, ValueError, urllib.error.URLError):
                pass

        mcp_configs, mcp_servers = discover_mcp_configs(self.mcp_path)
        providers = []
        for provider in PROVIDERS:
            row = dict(provider)
            row["authStatus"] = provider_auth_status(provider, opencode_auth)
            providers.append(row)
        emit({"type": "discovery", "profiles": profiles, "providers": providers,
              "mcpConfigs": mcp_configs, "mcpServers": mcp_servers})

    def configure(self, command):
        self.provider_id = str(command.get("providerId", self.provider_id) or "custom")
        provider = provider_by_id(self.provider_id)
        self.auth_mode = str(command.get("authMode", provider.get("defaultAuthMode", "key")) or "key")
        if self.auth_mode not in provider.get("authModes", ["key"]):
            self.auth_mode = provider.get("defaultAuthMode", "key")
        self.base_url = normalize_base_url(command.get("baseUrl", "") or provider.get("baseUrl", ""))
        self.model = str(command.get("model", "")).strip()
        self.thinking_level = str(command.get("thinkingLevel", self.thinking_level) or "").strip()
        self.mcp_path = os.path.expanduser(str(command.get("mcpPath", "")).strip())
        enabled = command.get("mcpEnabled", [])
        self.mcp_enabled = [str(item) for item in enabled] if isinstance(enabled, list) else []
        self.close_mcp()
        models = self.fetch_models()
        statuses = self.load_mcp()
        emit({"type": "connected", "baseUrl": self.base_url, "providerId": self.provider_id,
              "authMode": self.auth_mode, "model": self.model, "models": models, "mcp": statuses})

    def provider_context(self):
        provider = provider_by_id(self.provider_id)
        return {
            "providerId": self.provider_id,
            "providerLabel": provider.get("label", self.provider_id or "Provider"),
            "authMode": self.auth_mode,
        }

    def fetch_models(self):
        if not self.base_url:
            raise ValueError("Enter an OpenAI-compatible endpoint.")
        if self.auth_mode == "oauth" and self.provider_id == "openai":
            get_opencode_oauth("openai")
            choices = [model_row("openai", model) for model in opencode_models("openai", OPENAI_PLAN_MODELS)]
            self.model_capabilities = {item["id"]: item.get("capabilities", {}) for item in choices}
            return choices
        if self.auth_mode == "oauth" and self.provider_id == "xai":
            get_opencode_oauth("xai")
            choices = [model_row("xai", model) for model in opencode_models("xai", XAI_PLAN_MODELS)]
            self.model_capabilities = {item["id"]: item.get("capabilities", {}) for item in choices}
            return choices
        models, _ = self.api_request("GET", "/models")
        choices = []
        for item in models.get("data", []):
            if not isinstance(item, dict):
                continue
            model_id = str(item.get("id", ""))
            if model_id:
                choices.append(model_row(self.provider_id, model_id, item))
        if not choices and self.model:
            choices.append(model_row(self.provider_id, self.model))
        if not choices:
            raise RuntimeError("The endpoint returned no models.")
        if self.model not in [item["id"] for item in choices]:
            self.model = choices[0]["id"]
        self.model_capabilities = {item["id"]: item.get("capabilities", {}) for item in choices}
        return choices

    def current_model_capabilities(self):
        capabilities = self.model_capabilities.get(self.model)
        return capabilities if isinstance(capabilities, dict) else model_capabilities(self.provider_id, self.model)

    def api_request(self, method, path, payload=None, on_delta=None, cancel_event=None):
        headers = {}
        if self.auth_mode == "oauth" and self.provider_id == "openai":
            return self.openai_plan_request(method, path, payload, on_delta=on_delta, cancel_event=cancel_event)
        if self.auth_mode == "oauth" and self.provider_id == "xai":
            auth = get_opencode_oauth("xai")
            headers["Authorization"] = "Bearer " + auth["access"]
            headers["User-Agent"] = opencode_user_agent()
            if method == "POST" and path == "/chat/completions":
                tools = self.openai_tools()
                return json_request(self.base_url + "/responses", "POST",
                                    response_payload_from_chat_payload(payload or {}, tools), headers,
                                    context=self.provider_context(), cancel_event=cancel_event)
        api_key = lookup_secret(self.base_url) if self.auth_mode != "none" else ""
        if api_key and "Authorization" not in headers:
            headers["Authorization"] = "Bearer " + api_key
        if self.provider_id == "openrouter":
            headers["X-OpenRouter-Title"] = "misza.ai-chat"
        request_payload = chat_completion_payload_for_provider(self.provider_id, payload) if method == "POST" and path == "/chat/completions" else payload
        return json_request(self.base_url + path, method, request_payload, headers,
                            context=self.provider_context(), cancel_event=cancel_event)

    def openai_plan_request(self, method, path, payload=None, on_delta=None, cancel_event=None):
        if method == "GET" and path == "/models":
            return {"data": [{"id": model} for model in opencode_models("openai", OPENAI_PLAN_MODELS)]}, {}
        if method != "POST" or path not in ("/chat/completions", "/responses"):
            raise ValueError("OpenAI ChatGPT plan OAuth supports chat requests only.")
        auth = get_opencode_oauth("openai")
        headers = {
            "Authorization": "Bearer " + auth["access"],
            "ChatGPT-Account-Id": str(auth.get("accountId", "")),
            "originator": "opencode",
            "User-Agent": opencode_user_agent(True),
            "session-id": self.current_chat_id or "misza-ai-chat",
        }
        residency = extract_openai_residency(auth["access"])
        if residency:
            headers["x-openai-internal-codex-residency"] = residency
        tools = self.openai_tools()
        return stream_json_request(OPENAI_CODEX_ENDPOINT,
                                   response_payload_from_chat_payload(payload or {}, tools, stream=True),
                                   headers, on_delta=on_delta, context=self.provider_context(),
                                   cancel_event=cancel_event)

    def chat_request_with_retries(self, payload, on_delta, can_retry, cancel_event):
        max_attempts = len(CHAT_RETRY_DELAYS) + 1
        attempt = 1
        while True:
            check_cancel(cancel_event)
            try:
                return self.api_request("POST", "/chat/completions", payload,
                                        on_delta=on_delta, cancel_event=cancel_event)
            except ProviderRequestError as error:
                if attempt >= max_attempts or not error.retryable or not can_retry():
                    raise
                delay = max(CHAT_RETRY_DELAYS[attempt - 1], error.retry_after)
                delay = min(delay, 12.0)
                emit({"type": "chatRetry", "attempt": attempt + 1, "maxAttempts": max_attempts,
                      "delay": delay, "message": str(error), "debug": error.debug})
                sleep_with_cancel(delay, cancel_event)
                attempt += 1

    def selected_mcp_configs(self):
        selected = {}
        for key in self.mcp_enabled:
            path, name = split_mcp_key(key)
            if path and name:
                selected.setdefault(path, set()).add(name)
        if not selected and self.mcp_path:
            path = os.path.abspath(os.path.expanduser(self.mcp_path))
            try:
                servers = extract_mcp_servers(read_json_file(path))
                if servers:
                    selected[path] = set(servers.keys())
            except Exception:
                pass
        return selected

    def load_mcp(self):
        statuses = []
        selected = self.selected_mcp_configs()
        for path, names in selected.items():
            try:
                servers = extract_mcp_servers(read_json_file(path))
            except FileNotFoundError:
                statuses.append({"key": mcp_key(path, "Configuration"), "name": "Configuration", "path": path, "status": "not found"})
                continue
            except Exception as error:
                statuses.append({"key": mcp_key(path, "Configuration"), "name": "Configuration", "path": path, "status": compact_error(error)})
                continue
            for name in sorted(names):
                config = servers.get(name)
                key = mcp_key(path, name)
                if not isinstance(config, dict):
                    statuses.append({"key": key, "name": name, "path": path, "status": "invalid configuration"})
                    continue
                client = McpClient(str(name), config)
                try:
                    status = client.connect()
                    if status == "connected":
                        self.mcp_clients[client.name] = client
                        for tool in client.tools:
                            tool_name = str(tool.get("name", ""))
                            function_name = self.function_name(client.name, tool_name)
                            self.tool_map[function_name] = (client, tool_name)
                    statuses.append({"key": key, "name": client.name, "path": path, "status": status})
                except Exception as error:
                    client.close()
                    statuses.append({"key": key, "name": client.name, "path": path, "status": compact_error(error)})
        return statuses

    def function_name(self, server_name, tool_name):
        base = re.sub(r"[^A-Za-z0-9_-]", "_", "mcp_" + server_name + "_" + tool_name)
        candidate = base[:64]
        suffix = 2
        while candidate in self.tool_map:
            marker = "_" + str(suffix)
            candidate = base[:64 - len(marker)] + marker
            suffix += 1
        return candidate

    def openai_tools(self):
        tools = []
        for function_name, (client, tool_name) in self.tool_map.items():
            source = next((tool for tool in client.tools if tool.get("name") == tool_name), {})
            tools.append({
                "type": "function",
                "function": {
                    "name": function_name,
                    "description": str(source.get("description", "")),
                    "parameters": source.get("inputSchema", {"type": "object", "properties": {}}),
                },
            })
        return tools

    def emit_chats(self):
        rows = []
        for chat in read_chats():
            rows.append({
                "id": str(chat.get("id", "")),
                "title": str(chat.get("title", "New chat")),
                "updatedAt": str(chat.get("updatedAt", "")),
                "model": str(chat.get("model", "")),
                "providerId": str(chat.get("providerId", "")),
            })
        rows.sort(key=lambda item: item.get("updatedAt", ""), reverse=True)
        previous_group = None
        for row in rows:
            group = chat_group_label(row.get("updatedAt", ""))
            row["group"] = group
            row["showGroup"] = group != previous_group
            previous_group = group
        emit({"type": "chats", "chats": rows[:50], "currentChatId": self.current_chat_id})

    def save_current_chat(self):
        if not self.current_chat_id or not self.ui_messages:
            return
        existing = None
        chats = []
        for chat in read_chats():
            if chat.get("id") == self.current_chat_id:
                existing = chat
            else:
                chats.append(chat)
        created_at = existing.get("createdAt", now_iso()) if isinstance(existing, dict) else now_iso()
        chats.append({
            "id": self.current_chat_id,
            "title": self.current_title or "New chat",
            "createdAt": created_at,
            "updatedAt": now_iso(),
            "providerId": self.provider_id,
            "baseUrl": self.base_url,
            "model": self.model,
            "messages": self.messages,
            "uiMessages": self.ui_messages,
        })
        chats.sort(key=lambda item: item.get("updatedAt", ""), reverse=True)
        write_chats(chats[:100])

    def load_chat(self, chat_id):
        for chat in read_chats():
            if str(chat.get("id", "")) != str(chat_id):
                continue
            self.current_chat_id = str(chat.get("id", ""))
            self.current_title = str(chat.get("title", "New chat"))
            self.messages = chat.get("messages", []) if isinstance(chat.get("messages"), list) else []
            self.ui_messages = chat.get("uiMessages", []) if isinstance(chat.get("uiMessages"), list) else []
            emit({"type": "chatLoaded", "chatId": self.current_chat_id, "messages": self.ui_messages})
            self.emit_chats()
            return
        raise ValueError("Saved chat not found.")

    def delete_chat(self, chat_id):
        chats = [chat for chat in read_chats() if str(chat.get("id", "")) != str(chat_id)]
        write_chats(chats)
        if self.current_chat_id == str(chat_id):
            self.reset_chat(save=False)
        self.emit_chats()

    def rename_chat(self, chat_id, title):
        title = " ".join(str(title or "").strip().split())
        if not title:
            raise ValueError("Enter a chat title.")
        found = False
        chats = []
        for chat in read_chats():
            if str(chat.get("id", "")) == str(chat_id):
                chat = dict(chat)
                chat["title"] = title[:120]
                found = True
                if self.current_chat_id == str(chat_id):
                    self.current_title = chat["title"]
            chats.append(chat)
        if not found:
            raise ValueError("Saved chat not found.")
        write_chats(chats)
        self.emit_chats()

    def reset_chat(self, save=True):
        if save:
            self.save_current_chat()
        self.messages = []
        self.ui_messages = []
        self.current_chat_id = ""
        self.current_title = ""
        emit({"type": "chatReset"})
        self.emit_chats()

    def is_current_chat_token(self, token):
        with self.chat_state_lock:
            return self.chat_token == token

    def start_chat(self, prompt, attachments, thinking_level="", retry=False):
        with self.chat_state_lock:
            if self.chat_thread and self.chat_thread.is_alive() and self.chat_cancel and not self.chat_cancel.is_set():
                raise RuntimeError("A response is already in progress.")
            cancel_event = threading.Event()
            token = uuid.uuid4().hex
            thread = threading.Thread(
                target=self.chat_worker,
                args=(token, cancel_event, prompt, attachments, thinking_level, retry),
                daemon=True,
            )
            self.chat_cancel = cancel_event
            self.chat_token = token
            self.chat_thread = thread
        thread.start()

    def stop_chat(self):
        with self.chat_state_lock:
            active = self.chat_thread and self.chat_thread.is_alive() and self.chat_cancel
            cancel_event = self.chat_cancel
        if not active:
            emit({"type": "notice", "message": "No response is running."})
            return
        cancel_event.set()
        emit({"type": "chatStopped", "chatId": self.current_chat_id})

    def chat_worker(self, token, cancel_event, prompt, attachments, thinking_level, retry):
        try:
            self.chat(prompt, attachments, thinking_level, append_user=not retry, cancel_event=cancel_event)
        except ChatCancelled:
            pass
        except ProviderRequestError as error:
            if not cancel_event.is_set() and self.is_current_chat_token(token):
                emit(error_event("chat", error))
        except Exception as error:
            if not cancel_event.is_set() and self.is_current_chat_token(token):
                emit(error_event("chat", error))
        finally:
            with self.chat_state_lock:
                if self.chat_token == token:
                    self.chat_thread = None
                    self.chat_cancel = None
                    self.chat_token = ""

    def chat(self, prompt, attachments, thinking_level="", append_user=True, cancel_event=None):
        if not self.base_url or not self.model:
            raise ValueError("Connect an endpoint and select a model first.")
        check_cancel(cancel_event)
        if thinking_level:
            self.thinking_level = str(thinking_level).strip()
        if append_user:
            summaries = [attachment_summary(item.get("source", item.get("path", "")), item.get("mime", ""))
                         for item in attachments if isinstance(item, dict)]
            if not self.current_chat_id:
                self.current_chat_id = uuid.uuid4().hex
                self.current_title = chat_title(prompt)
            self.messages.append({"role": "user", "content": content_from_prompt(prompt, attachments, self.provider_id)})
            self.ui_messages.append({"role": "You", "text": prompt, "attachments": summaries})
        elif not self.messages or self.messages[-1].get("role") not in ("user", "tool"):
            raise RuntimeError("There is no failed user message to retry.")
        for _ in range(MAX_TOOL_ROUNDS):
            check_cancel(cancel_event)
            streamed = False

            def on_delta(text):
                nonlocal streamed
                check_cancel(cancel_event)
                streamed = True
                emit({"type": "chatDelta", "text": text, "chatId": self.current_chat_id})

            payload = {"model": self.model, "messages": self.messages, "thinkingLevel": self.thinking_level}
            tools = self.openai_tools()
            capabilities = self.current_model_capabilities()
            if tools and capabilities.get("toolCalls", True):
                payload["tools"] = tools
                if capabilities.get("toolChoice", True):
                    payload["tool_choice"] = "auto"
            response, _ = self.chat_request_with_retries(payload, on_delta, lambda: not streamed, cancel_event)
            check_cancel(cancel_event)
            message = message_from_completion_response(response)
            if not message:
                raise RuntimeError("The endpoint returned no completion.")
            self.messages.append(message)
            calls = message.get("tool_calls", [])
            if not calls:
                text = message.get("content") or ""
                self.ui_messages.append({"role": "AI", "text": text})
                self.save_current_chat()
                self.emit_chats()
                emit({"type": "chat", "text": text, "chatId": self.current_chat_id, "streamed": streamed})
                return
            for call in calls:
                check_cancel(cancel_event)
                function = call.get("function", {})
                name = function.get("name", "")
                try:
                    arguments = json.loads(function.get("arguments", "{}"))
                    client, tool_name = self.tool_map[name]
                    result = client.request("tools/call", {"name": tool_name, "arguments": arguments})
                    content = json.dumps(result, ensure_ascii=False)
                    status = "ok"
                except Exception as error:
                    content = json.dumps({"error": compact_error(error)}, ensure_ascii=False)
                    status = "error"
                tool_text = name + " -> " + content[:1200]
                self.ui_messages.append({"role": "Tool", "text": tool_text, "status": status})
                emit({"type": "toolCall", "name": name, "status": status, "text": tool_text})
                self.messages.append({"role": "tool", "tool_call_id": call.get("id", ""), "content": content})
        raise RuntimeError("The model exceeded the maximum number of MCP tool calls.")

    def close_mcp(self):
        for client in self.mcp_clients.values():
            client.close()
        self.mcp_clients = {}
        self.tool_map = {}


def main():
    bridge = Bridge()
    emit({"type": "ready"})
    for line in sys.stdin:
        operation = ""
        try:
            command = json.loads(line)
            operation = command.get("op")
            if operation == "discover":
                bridge.discover()
            elif operation == "configure":
                bridge.configure(command)
            elif operation == "saveKey":
                store_secret(command.get("baseUrl", ""), str(command.get("key", "")))
                emit({"type": "keySaved"})
            elif operation in ("openKeyPage", "authPage"):
                provider = provider_by_id(str(command.get("providerId", "")))
                open_url(provider.get("keyUrl", ""))
                emit({"type": "notice", "message": "Opened API key page for " + provider.get("label", "provider") + "."})
            elif operation == "pickFiles":
                emit({"type": "filesPicked", "files": pick_files()})
            elif operation == "startOAuth":
                provider = provider_by_id(str(command.get("providerId", "")))
                oauth = provider.get("oauth", {}) if isinstance(provider.get("oauth", {}), dict) else {}
                if oauth.get("kind") == "opencode-openai":
                    result = run_openai_opencode_oauth()
                elif oauth.get("kind") == "opencode-xai":
                    result = run_xai_device_oauth()
                elif oauth.get("kind") == "openrouter":
                    result = run_openrouter_oauth(command.get("baseUrl", provider.get("baseUrl", "")))
                elif oauth.get("kind") == "standard":
                    command.update({
                        "authorizationUrl": oauth.get("authorizationUrl", ""),
                        "tokenUrl": oauth.get("tokenUrl", ""),
                        "clientId": oauth.get("clientId", ""),
                        "scope": oauth.get("scope", ""),
                        "audience": oauth.get("audience", ""),
                        "redirectUri": oauth.get("redirectUri", "http://127.0.0.1:53682/callback"),
                    })
                    result = run_oauth_pkce(command)
                else:
                    raise ValueError("This provider has no built-in browser auth flow.")
                emit({"type": "oauthSaved", "expiresIn": result.get("expiresIn", 0),
                      "tokenType": result.get("tokenType", "Bearer")})
            elif operation == "chat":
                attachments = command.get("attachments", [])
                bridge.start_chat(str(command.get("prompt", "")), attachments if isinstance(attachments, list) else [],
                                  str(command.get("thinkingLevel", "") or ""))
            elif operation == "retry":
                bridge.start_chat("", [], str(command.get("thinkingLevel", "") or ""), retry=True)
            elif operation == "stop":
                bridge.stop_chat()
            elif operation == "model":
                bridge.model = str(command.get("model", "")).strip()
            elif operation == "thinking":
                bridge.thinking_level = str(command.get("thinkingLevel", "") or "").strip()
            elif operation == "listChats":
                bridge.emit_chats()
            elif operation == "loadChat":
                bridge.load_chat(str(command.get("id", "")))
            elif operation == "deleteChat":
                bridge.delete_chat(str(command.get("id", "")))
            elif operation == "renameChat":
                bridge.rename_chat(str(command.get("id", "")), str(command.get("title", "")))
            elif operation == "reset":
                bridge.reset_chat()
            elif operation == "shutdown":
                break
            else:
                raise ValueError("Unknown bridge command.")
        except Exception as error:
            emit(error_event(operation, error))
    bridge.close_mcp()


if __name__ == "__main__":
    main()
